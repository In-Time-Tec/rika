{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@rika/box-executor",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./bootstrap": "./src/bootstrap.ts",
    "./contract": "./src/contract.ts",
    "./enrollment": "./src/enrollment.ts",
    "./lifecycle": "./src/lifecycle.ts",
    "./provider": "./src/provider.ts",
    "./tool": "./src/tool.ts",
    "./workspace-input": "./src/workspace-input.ts",
    "./workspace-input-contract": "./src/workspace-input-contract.ts"
  },
  "scripts": {
    "lint": "bun --cwd ../.. node_modules/oxlint/dist/cli.js --deny-warnings packages/box-executor/src packages/box-executor/test",
    "test": "bun --cwd ../.. --bun vitest run --project unit packages/box-executor",
    "typecheck": "bun ../../node_modules/typescript/lib/tsc.js --noEmit"
  },
  "dependencies": {
    "@rika/execution": "workspace:*",
    "@rika/product": "workspace:*",
    "@rika/workspace-input": "workspace:*",
    "effect": "4.0.0-rc.112",
    "generalist": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "@types/bun": "1.4.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "rika": {
    "kind": "adapter",
    "domain": "execution"
  }
}
