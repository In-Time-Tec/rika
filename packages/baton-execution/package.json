{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@rika/baton-execution",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./baton-execution": "./src/baton-execution.ts",
    "./baton-route": "./src/baton-route.ts",
    "./scripted-model": "./src/scripted-model.ts"
  },
  "dependencies": {
    "@batonfx/core": "catalog:",
    "@batonfx/providers": "catalog:",
    "@batonfx/runtime": "catalog:",
    "@batonfx/test": "catalog:",
    "@rika/coding-tools": "workspace:*",
    "@rika/product": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@rika/configuration": "workspace:*",
    "@rika/javascript-sandbox": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "rika": {
    "kind": "adapter",
    "domain": "execution"
  },
  "scripts": {
    "lint": "bun --cwd ../.. node_modules/oxlint/dist/cli.js packages/baton-execution/src packages/baton-execution/test",
    "typecheck": "bun ../../node_modules/typescript/lib/tsc.js --noEmit"
  }
}
