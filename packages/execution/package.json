{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@rika/execution",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/engine/runtime.ts",
    "./route": "./src/routing/route.ts",
    "./local-tools": "./src/tool/local.ts",
    "./remote-tools": "./src/remote-tools.ts",
    "./postgres": "./src/postgres.ts",
    "./scripted-model": "./src/scripted-model.ts",
    "./test-harness": "./src/test-harness.ts",
    "./terminal-unknown": "./src/routing/terminal-unknown.ts"
  },
  "dependencies": {
    "@effect/sql-pg": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@aws-sdk/client-bedrock-runtime": "catalog:",
    "@aws-sdk/credential-provider-node": "catalog:",
    "@rika/product": "workspace:*",
    "effect": "catalog:",
    "generalist": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@rika/configuration": "workspace:*",
    "@types/bun": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "rika": {
    "kind": "adapter",
    "domain": "execution"
  },
  "scripts": {
    "lint": "bun --cwd ../.. node_modules/oxlint/dist/cli.js --deny-warnings packages/execution/src packages/execution/test",
    "typecheck": "bun ../../node_modules/typescript/lib/tsc.js --noEmit"
  }
}
