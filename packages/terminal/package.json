{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@rika/terminal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./opentui-surface": "./src/opentui/surface/service.ts",
    "./terminal-message": "./src/state/message.ts",
    "./terminal-performance-evaluation": "./src/performance/evaluation.ts",
    "./terminal-session": "./src/terminal-session.ts",
    "./terminal-state": "./src/state/model.ts",
    "./terminal-state-reducer": "./src/state/reducer/model.ts",
    "./terminal-timeline-bounds": "./src/state/transcript/timeline-bounds.ts",
    "./terminal-transcript-presentation": "./src/presentation/transcript/formatter.ts",
    "./transcript-viewport": "./src/presentation/transcript/viewport/model.ts",
    "./terminal-submission-state": "./src/state/submission.ts"
  },
  "dependencies": {
    "@opentui/core": "catalog:",
    "@pierre/diffs": "catalog:",
    "@rika/configuration": "workspace:*",
    "@rika/transcript": "workspace:*",
    "cli-spinners": "catalog:",
    "effect": "catalog:",
    "marked": "catalog:",
    "prismjs": "catalog:",
    "string-width": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@types/prismjs": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "rika": {
    "kind": "adapter",
    "domain": "terminal"
  },
  "scripts": {
    "lint": "bun --cwd ../.. node_modules/oxlint/dist/cli.js packages/terminal/src packages/terminal/test",
    "typecheck": "bun ../../node_modules/typescript/lib/tsc.js --noEmit"
  }
}
