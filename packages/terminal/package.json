{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@rika/terminal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./terminal-performance-evaluation": "./src/performance.ts",
    "./terminal-transcript-presentation": "./src/transcript-presenter.ts",
    "./transcript-viewport": "./src/transcript-viewport.ts",
    "./opentui-surface": "./src/adapter.ts",
    "./terminal-message": "./src/view-state.ts",
    "./terminal-state": "./src/terminal-state.ts",
    "./terminal-state-reducer": "./src/view-state.ts",
    "./terminal-session": "./src/session.ts"
  },
  "dependencies": {
    "@opentui/core": "catalog:",
    "@pierre/diffs": "catalog:",
    "@rika/configuration": "workspace:*",
    "@rika/transcript": "workspace:*",
    "cli-spinners": "catalog:",
    "effect": "catalog:",
    "marked": "catalog:",
    "prismjs": "catalog:",
    "string-width": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@types/prismjs": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "rika": {
    "kind": "adapter",
    "domain": "terminal"
  },
  "scripts": {
    "lint": "bun --cwd ../.. node_modules/oxlint/dist/cli.js packages/terminal/src packages/terminal/test",
    "typecheck": "bun ../../node_modules/typescript/lib/tsc.js --noEmit"
  }
}
