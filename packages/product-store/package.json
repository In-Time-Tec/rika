{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@rika/product-store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./product-database-layer": "./src/product-database.ts",
    "./sqlite-thread-interaction-repository": "./src/thread-interaction-repository.ts",
    "./sqlite-thread-search-repository": "./src/thread-search-repository.ts",
    "./sqlite-thread-summary-repository": "./src/thread-summary-repository.ts",
    "./sqlite-thread-repository": "./src/thread-repository.ts",
    "./sqlite-transcript-repository": "./src/transcript-repository.ts",
    "./sqlite-turn-repository": "./src/turn-repository.ts",
    "./sqlite-usage-repository": "./src/usage-repository.ts"
  },
  "dependencies": {
    "@effect/sql-sqlite-bun": "catalog:",
    "@rika/transcript": "workspace:*",
    "effect": "catalog:",
    "@rika/product": "workspace:*"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@rika/configuration": "workspace:*",
    "@rika/coding-tools": "workspace:*",
    "@rika/extensions": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "rika": {
    "kind": "adapter",
    "domain": "product-store"
  },
  "scripts": {
    "lint": "bun --cwd ../.. node_modules/oxlint/dist/cli.js packages/product-store/src packages/product-store/test",
    "typecheck": "bun ../../node_modules/typescript/lib/tsc.js --noEmit"
  }
}
