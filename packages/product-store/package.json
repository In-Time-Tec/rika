{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@rika/product-store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./memory-hosted-authority-repository": "./src/hosted/memory-hosted-authority-repository.ts",
    "./postgres-hosted-authority-layer": "./src/hosted/postgres-hosted-authority-layer.ts",
    "./postgres-hosted-authority-repository": "./src/hosted/postgres-hosted-authority-repository.ts",
    "./migrations/postgres/0001-hosted-authority.sql": "./migrations/postgres/0001-hosted-authority.sql",
    "./product-database-layer": "./src/database/product-database-layer.ts",
    "./sqlite-goal-repository": "./src/goal/sqlite-goal-repository.ts",
    "./sqlite-thread-search-repository": "./src/search/sqlite-thread-search-repository.ts",
    "./sqlite-thread-summary-repository": "./src/summary/sqlite-thread-summary-repository.ts",
    "./sqlite-thread-repository": "./src/thread/sqlite-thread-repository.ts",
    "./sqlite-transcript-repository": "./src/transcript/sqlite-transcript-repository.ts",
    "./sqlite-turn-repository": "./src/turn/sqlite-turn-repository.ts"
  },
  "dependencies": {
    "@effect/sql-pg": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@rika/product": "workspace:*",
    "@rika/transcript": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@rika/configuration": "workspace:*",
    "@rika/coding-tools": "workspace:*",
    "@rika/extensions": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "rika": {
    "kind": "adapter",
    "domain": "product-store"
  },
  "scripts": {
    "lint": "bun --cwd ../.. node_modules/oxlint/dist/cli.js packages/product-store/src packages/product-store/test",
    "typecheck": "bun ../../node_modules/typescript/lib/tsc.js --noEmit"
  }
}
