    "./authorization-state": "./src/authorization-state.ts",
    "./github-model": "./src/model.ts",
    "./installation-service": "./src/installation/service.ts",
    "./installation-token": "./src/installation/token.ts",
    "./webhook-delivery": "./src/webhook/delivery.ts",
