{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "rika",
  "description": "Local Effect-native durable coding agent CLI and TUI",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@ast-grep/cli": "0.44.0",
      "tenetkit": "0.31.0",
      "@effect/platform-bun": "4.0.0-rc.109",
      "@effect/sql-mysql2": "4.0.0-rc.109",
      "@effect/sql-sqlite-bun": "4.0.0-rc.109",
      "@effect/tsgo": "0.27.1",
      "@effect/vitest": "4.0.0-rc.109",
      "@opentui/core": "0.4.3",
      "@opentui/core-darwin-arm64": "0.4.3",
      "@opentui/core-darwin-x64": "0.4.3",
      "@opentui/core-linux-arm64": "0.4.3",
      "@opentui/core-linux-arm64-musl": "0.4.3",
      "@opentui/core-linux-x64": "0.4.3",
      "@opentui/core-linux-x64-musl": "0.4.3",
      "@opentui/core-win32-arm64": "0.4.3",
      "@opentui/core-win32-x64": "0.4.3",
      "@opencode-ai/models": "0.0.18",
      "@pierre/diffs": "1.2.11",
      "@tsconfig/bun": "1.0.9",
      "@types/bun": "1.3.13",
      "@types/node": "24.12.2",
      "@types/prismjs": "1.26.6",
      "@vitest/coverage-v8": "4.1.11",
      "cli-spinners": "3.4.0",
      "effect": "4.0.0-rc.109",
      "marked": "17.0.1",
      "oxlint": "1.77.0",
      "oxlint-tsgolint": "7.0.2001",
      "parallel-web": "1.1.0",
      "prettier": "3.6.2",
      "prismjs": "1.30.0",
      "string-width": "7.2.0",
      "turbo": "2.8.13",
      "typescript": "7.0.2",
      "vitest": "4.1.11"
    }
  },
  "scripts": {
    "bench": "bun run scripts/benchmark/benchmark-runner.ts",
    "ast-grep-check": "ast-grep scan --config sgconfig.yml --report-style short apps packages scripts test",
    "build": "bun turbo build",
    "check": "bun turbo run --continue typecheck \"//#ast-grep-check\" \"//#lint\"",
    "dev": "bun --cwd apps/rika start",
    "format": "prettier --write .",
    "install-local": "bun run scripts/installation/install-local.ts",
    "lint": "bun node_modules/oxlint/dist/cli.js apps packages scripts",
    "local-baton-smoke": "bun run scripts/release/local-baton-smoke.ts",
    "package": "bun run scripts/packaging/package-target.ts",
    "npm-package": "bun run scripts/packaging/npm-package.ts",
    "release-smoke": "bun run scripts/release/release-smoke.ts",
    "test": "bun turbo run \"//#test-unit\"",
    "test-proc": "bun --bun vitest run --project proc",
    "test-tui": "bun --bun vitest run --project tui",
    "test-unit": "bun --bun vitest run --project unit",
    "typecheck": "bun turbo run typecheck",
    "uninstall-local": "bun run scripts/installation/uninstall-local.ts",
    "prepare": "effect-tsgo patch --no-typescript --oxlint"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1094.0",
    "tenetkit": "catalog:",
    "@effect/ai-anthropic": "4.0.0-rc.109",
    "@effect/ai-openai": "4.0.0-rc.109",
    "@effect/ai-openai-compat": "4.0.0-rc.109",
    "@effect/ai-openrouter": "4.0.0-rc.109",
    "@effect/platform-bun": "catalog:",
    "@effect/sql-pg": "4.0.0-rc.109",
    "@effect/sql-sqlite-bun": "catalog:",
    "@rika/product": "workspace:*",
    "@rika/kernel": "workspace:*",
    "@rika/product-store": "workspace:*",
    "@rika/transcript": "workspace:*",
    "drizzle-orm": "1.0.0-rc.3",
    "effect": "catalog:",
    "pg": "8.21.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "rika": {
    "kind": "application",
    "domain": "repository"
  }
}
