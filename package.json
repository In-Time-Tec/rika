{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "rika",
  "description": "Local Effect-native durable coding agent CLI and TUI",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@ast-grep/cli": "0.44.0",
      "tenetkit": "0.40.0",
      "@aws-sdk/client-bedrock-runtime": "3.859.0",
      "@aws-sdk/credential-provider-node": "3.859.0",
      "@effect/platform-bun": "4.0.0-rc.111",
      "@effect/sql-mysql2": "4.0.0-rc.111",
      "@effect/sql-pg": "4.0.0-rc.111",
      "@effect/tsgo": "0.36.5",
      "@foldkit/ui": "0.148.2",
      "@foldkit/vite-plugin": "0.16.1",
      "@effect/vitest": "4.0.0-rc.111",
      "@opentui/core": "0.4.3",
      "@opentui/core-darwin-arm64": "0.4.3",
      "@opentui/core-darwin-x64": "0.4.3",
      "@opentui/core-linux-arm64": "0.4.3",
      "@opentui/core-linux-arm64-musl": "0.4.3",
      "@opentui/core-linux-x64": "0.4.3",
      "@opentui/core-linux-x64-musl": "0.4.3",
      "@modelcontextprotocol/sdk": "1.29.0",
      "@opentui/core-win32-arm64": "0.4.3",
      "@opentui/core-win32-x64": "0.4.3",
      "@opencode-ai/models": "0.0.18",
      "@oxlint/plugins": "1.78.0",
      "@pierre/diffs": "1.2.11",
      "@tsconfig/bun": "1.0.9",
      "@types/bun": "1.4.0",
      "@types/node": "24.12.2",
      "@types/prismjs": "1.26.6",
      "@vitest/coverage-v8": "4.1.11",
      "cli-spinners": "3.4.0",
      "drizzle-orm": "1.0.0-rc.5-169397b",
      "foldkit": "0.148.2",
      "happy-dom": "20.10.6",
      "effect": "4.0.0-rc.111",
      "marked": "17.0.1",
      "oxlint": "1.78.0",
      "oxlint-tsgolint": "7.0.2001",
      "parallel-web": "1.1.0",
      "prettier": "3.6.2",
      "prismjs": "1.30.0",
      "string-width": "7.2.0",
      "turbo": "2.8.13",
      "typescript": "7.0.2",
      "vite": "8.1.3",
      "vitest": "4.1.11"
    }
  },
  "overrides": {
    "fast-xml-parser": "5.5.6"
  },
  "trustedDependencies": [
    "@ast-grep/cli"
  ],
  "scripts": {
    "ast-grep-check": "ast-grep scan --config sgconfig.yml --report-style short apps packages scripts test",
    "build": "bun turbo build",
    "check": "bun turbo run --continue typecheck \"//#ast-grep-check\" \"//#lint\" \"//#repo-lint\"",
    "dev": "alchemy dev",
    "format": "prettier --write --cache .",
    "lint": "bun node_modules/oxlint/dist/cli.js --deny-warnings .",
    "package": "bun run scripts/packaging/package-target.ts",
    "npm-package": "bun run scripts/packaging/npm-package.ts",
    "repo-lint": "repo-lint check --no-cache",
    "test": "bun turbo run \"//#test-unit\"",
    "test-proc": "bun --bun vitest run --project proc",
    "test-tui": "bun --bun vitest run --project tui --passWithNoTests",
    "test-unit": "bun --bun vitest run --project unit",
    "test-changed": "bun --bun vitest run --changed HEAD",
    "typecheck": "bun turbo run typecheck",
    "prepare": "effect-tsgo patch --no-typescript --oxlint"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1094.0",
    "tenetkit": "catalog:",
    "@effect/ai-anthropic": "4.0.0-rc.111",
    "@effect/ai-openai": "4.0.0-rc.111",
    "@effect/ai-openai-compat": "4.0.0-rc.111",
    "@effect/ai-openrouter": "4.0.0-rc.111",
    "@effect/platform-bun": "catalog:",
    "@effect/sql-pg": "4.0.0-rc.111",
    "@rika/product": "workspace:*",
    "@rika/kernel": "workspace:*",
    "@rika/product-store": "workspace:*",
    "@rika/transcript": "workspace:*",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "pg": "8.21.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "catalog:",
    "@effect/platform-node": "4.0.0-rc.111",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@rikalabs/repo-lint": "2.3.0",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "8.15.5",
    "@vitest/coverage-v8": "catalog:",
    "alchemy": "2.0.0-beta.74",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "rika": {
    "kind": "application",
    "domain": "repository"
  }
}
