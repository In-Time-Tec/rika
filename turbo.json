{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "//#repository-policy": {
      "inputs": [
        "package.json",
        "bun.lock",
        "apps/*/package.json",
        "packages/*/package.json",
        "tooling/*/package.json",
        "tooling/repository-policy/**/*.ts",
        "tooling/repository-policy/**/*.json",
        "apps/**/*",
        "packages/**/*",
        "scripts/**/*",
        "test/**/*",
        "AGENTS.md",
        "CONTEXT.md",
        "PRODUCT.md",
        "plans/**/*.md",
        "docs/features/**/*.md",
        "docs/decisions/**/*.md"
      ]
    },
    "//#repository-graph-check": {
      "inputs": [
        "package.json",
        "bun.lock",
        "tsconfig.json",
        "apps/**/*",
        "packages/**/*",
        "scripts/**/*",
        "test/**/*",
        "tooling/repository-graph/**/*",
        "tooling/repository-policy/**/*",
        "docs/generated/*.json",
        "docs/**/*.md",
        "plans/**/*.md"
      ]
    },
    "//#diagnostics": {
      "inputs": [
        "tsconfig.json",
        "bun.lock",
        "apps/**/*.ts",
        "packages/**/*.ts",
        "scripts/**/*.ts",
        "tooling/**/*.ts",
        "test/**/*.ts",
        "!**/dist/**"
      ]
    },
    "//#format-check": {
      "inputs": [
        "package.json",
        ".prettierignore",
        "**/*.ts",
        "**/*.js",
        "**/*.json",
        "**/*.md",
        "**/*.yml",
        "**/*.yaml",
        "!repos/**",
        "!artifacts/**",
        "!plans/**",
        "!**/dist/**",
        "!coverage/**",
        "!packages/terminal/test/fixtures/visual/*.styles.json"
      ]
    },
    "//#lint": {
      "inputs": [
        "package.json",
        "apps/**/*.ts",
        "packages/**/*.ts",
        "scripts/**/*.ts",
        "tooling/**/*.ts",
        "!**/dist/**"
      ]
    },
    "//#test-unit": {
      "inputs": [
        "vitest.config.ts",
        "tsconfig.json",
        "bun.lock",
        "apps/**",
        "packages/**",
        "scripts/**",
        "tooling/**",
        "test/**",
        "!**/dist/**"
      ]
    },
    "//#test-tui": {
      "inputs": [
        "vitest.config.ts",
        "tsconfig.json",
        "bun.lock",
        "apps/**",
        "packages/**",
        "scripts/**",
        "tooling/**",
        "test/**",
        "!**/dist/**"
      ]
    },
    "//#test-proc": {
      "inputs": [
        "vitest.config.ts",
        "tsconfig.json",
        "bun.lock",
        "apps/**",
        "packages/**",
        "scripts/**",
        "tooling/**",
        "test/**",
        "!**/dist/**"
      ]
    },
    "//#ast-grep-check": {
      "inputs": [
        "sgconfig.yml",
        "ast-grep/**",
        "apps/**/*.ts",
        "packages/**/*.ts",
        "scripts/**/*.ts",
        "tooling/**/*.ts",
        "test/**/*.ts",
        "!**/dist/**"
      ]
    }
  }
}
