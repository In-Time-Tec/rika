{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "//#lint": {
      "inputs": [
        ".oxlintrc.json",
        "package.json",
        "bun.lock",
        "tools/oxlint/**",
        "apps/**/*.ts",
        "packages/**/*.ts",
        "scripts/**/*.ts",
        "test/**/*.ts",
        "*.ts",
        "!**/dist/**"
      ]
    },
    "//#test-unit": {
      "inputs": [
        "vitest.config.ts",
        "tsconfig.json",
        "bun.lock",
        "apps/**",
        "packages/**",
        "scripts/**",
        "test/**",
        "!**/dist/**"
      ],
      "env": ["RIKA_HOSTED_POSTGRES_TEST_DATABASE_URL"]
    },
    "//#test-tui:run": {
      "inputs": [
        "vitest.config.ts",
        "tsconfig.json",
        "bun.lock",
        "apps/**",
        "packages/**",
        "scripts/**",
        "test/**",
        "!**/dist/**"
      ],
      "env": ["ENV", "BASH_ENV"]
    },
    "//#test-proc:run": {
      "inputs": [
        "vitest.config.ts",
        "tsconfig.json",
        "bun.lock",
        "apps/**",
        "packages/**",
        "scripts/**",
        "test/**",
        "!**/dist/**"
      ],
      "env": ["ENV", "BASH_ENV"]
    },
    "//#ast-grep-check": {
      "inputs": [
        "sgconfig.yml",
        "ast-grep/**",
        "apps/**/*.ts",
        "packages/**/*.ts",
        "scripts/**/*.ts",
        "test/**/*.ts",
        "!**/dist/**"
      ]
    },
    "//#repo-lint": {
      "inputs": [".repo-lint.yaml", ".gitignore", "apps/**", "packages/**", "!**/dist/**"]
    }
  }
}
