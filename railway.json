{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "apps/control-plane/**",
      "packages/**",
      "Dockerfile",
      "package.json",
      "bun.lock",
      "railway.json",
      "tsconfig.json"
    ]
  },
  "deploy": {
    "preDeployCommand": [
      "bun --cwd apps/control-plane migrate"
    ],
    "startCommand": "bun --cwd apps/control-plane start",
    "healthcheckPath": "/readyz",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "overlapSeconds": 30,
    "drainingSeconds": 60
  }
}
