{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@rika/repository-graph",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "rika": {
    "kind": "tooling",
    "domain": "repository-graph"
  },
  "scripts": {
    "generate": "bun ./src/repository-graph-main.ts generate",
    "query": "bun ./src/repository-graph-main.ts query",
    "check": "bun ./src/repository-graph-main.ts check-generated",
    "typecheck": "bun ../../node_modules/typescript/lib/tsc.js --noEmit",
    "test": "bun --cwd ../.. vitest run tooling/repository-graph/src"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "dependency-cruiser": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@rika/app": "workspace:*",
    "@rika/config": "workspace:*",
    "@rika/extensions": "workspace:*",
    "@rika/persistence": "workspace:*",
    "@rika/runtime": "workspace:*",
    "@rika/tools": "workspace:*",
    "@rika/transcript": "workspace:*",
    "@rika/tui": "workspace:*",
    "@typescript-eslint/parser": "catalog:"
  }
}
