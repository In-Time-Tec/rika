{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "error",
    "suspicious": "error"
  },
  "rules": {
    "no-nested-ternary": "error"
  },
  "overrides": [
    {
      "files": ["**/test/**"],
      "rules": {
        "no-await-in-loop": "off",
        "no-unused-vars": "off"
      }
    },
    {
      "files": ["packages/terminal/src/state/model/terminal-state.ts"],
      "rules": {
        "no-shadow": "off"
      }
    }
  ],
  "ignorePatterns": ["dist", "node_modules", ".turbo", "repos"]
}
