{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/rivet/Dockerfile",
    "watchPatterns": ["infra/rivet/**", "package.json", "bun.lock", "tsconfig.json"]
  },
  "deploy": {
    "startCommand": "bun infra/rivet/start.ts",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "overlapSeconds": 0,
    "drainingSeconds": 30
  }
}
