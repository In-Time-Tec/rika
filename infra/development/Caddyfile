{
	admin off
	auto_https off
}

127.0.0.1:{$PUBLIC_PORT} {
	@api path /api/* /healthz /readyz /.well-known/oauth-authorization-server/api/auth /.well-known/oauth-protected-resource/api/v1
	handle @api {
		reverse_proxy 127.0.0.1:{$API_PORT}
	}

	handle {
		reverse_proxy 127.0.0.1:{$WEB_PORT}
	}
}

127.0.0.1:{$EXECUTOR_PORT} {
	@executor path /api/v1/executors
	handle @executor {
		reverse_proxy 127.0.0.1:{$API_PORT}
	}

	handle {
		respond "Not found" 404
	}
}
