{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@rika/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun build ./src/main.ts --outdir dist/server --target bun --format esm && vite build",
    "lint": "bun --cwd ../.. node_modules/oxlint/dist/cli.js --deny-warnings apps/web/src apps/web/test",
    "start": "bun ./src/main.ts",
    "typecheck": "bun ../../node_modules/typescript/lib/tsc.js --noEmit"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@foldkit/ui": "catalog:",
    "@rika/product": "workspace:*",
    "effect": "catalog:",
    "foldkit": "catalog:",
    "marked": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@foldkit/vite-plugin": "catalog:",
    "@types/bun": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "rika": {
    "kind": "application",
    "domain": "web"
  }
}
