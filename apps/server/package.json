{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@rika/server",
  "version": "0.3.17",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun build ./src/server-main.ts --outdir dist --target bun --format esm --splitting --loader .txt:text --external @opentui/core-darwin-arm64 --external @opentui/core-darwin-x64 --external @opentui/core-linux-arm64 --external @opentui/core-linux-arm64-musl --external @opentui/core-linux-x64 --external @opentui/core-linux-x64-musl --external @opentui/core-win32-arm64 --external @opentui/core-win32-x64",
    "lint": "bun --cwd ../.. node_modules/oxlint/dist/cli.js apps/server/src apps/server/test",
    "start": "bun ./src/server-main.ts",
    "typecheck": "bun ../../node_modules/typescript/lib/tsc.js --noEmit"
  },
  "exports": {
    "./server-process-spawn": "./src/server/process/server-process-spawn.ts",
    "./server-process": "./src/server/process/server-process.ts",
    "./server-endpoint": "./src/server/process/server-endpoint.ts",
    "./server-startup": "./src/server/process/server-startup.ts",
    "./server-process-launch": "./src/server/process/server-process-launch.ts",
    "./server-host-transport": "./src/transport/host/server-host-transport.ts",
    "./server-message-codec": "./src/transport/protocol/server-message-codec.ts",
    "./server-protocol": "./src/transport/protocol/server-protocol.ts",
    "./server-protocol-handshake": "./src/transport/protocol/server-protocol-handshake.ts",
    "./application-version": "./src/platform/application-version.ts",
    "./diagnostic-file-logging": "./src/diagnostics/diagnostic-file-logging.ts",
    "./diagnostic-file-logging-contract": "./src/diagnostics/diagnostic-file-logging-contract.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@rika/config": "workspace:*",
    "@rika/execution": "workspace:*",
    "@rika/extensions": "workspace:*",
    "@rika/product": "workspace:*",
    "@rika/sandbox": "workspace:*",
    "@rika/store": "workspace:*",
    "@rika/tools": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "rika": {
    "kind": "application",
    "domain": "server"
  }
}
