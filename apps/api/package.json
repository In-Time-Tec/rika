{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@rika/api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun build ./src/main.ts --outdir dist --target bun --format esm",
    "lint": "bun --cwd ../.. node_modules/oxlint/dist/cli.js --deny-warnings apps/api/src apps/api/test",
    "migrate": "bun ./src/database/migrate.ts",
    "start": "bun ./src/main.ts",
    "typecheck": "bun ../../node_modules/typescript/lib/tsc.js --noEmit"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@rika/configuration": "workspace:*",
    "@rika/e2b-executor": "workspace:*",
    "@rika/execution": "workspace:*",
    "@rika/github-app": "workspace:*",
    "@rika/identity": "workspace:*",
    "@rika/product": "workspace:*",
    "@rika/product-store": "workspace:*",
    "@rika/remote-execution": "workspace:*",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "pg": "catalog:",
    "generalist": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "rika": {
    "kind": "application",
    "domain": "api"
  }
}
