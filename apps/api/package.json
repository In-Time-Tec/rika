{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@rika/api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun build ./src/main.ts --outdir dist --target bun --format esm",
    "lint": "bun --cwd ../.. node_modules/oxlint/dist/cli.js --deny-warnings apps/api/src apps/api/test",
    "migrate": "bun ./src/database/migrate.ts",
    "typecheck": "bun ../../node_modules/typescript/lib/tsc.js --noEmit",
    "start": "bun ./src/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1124.0",
    "@effect/ai-anthropic": "4.0.0-rc.112",
    "@effect/ai-openai": "4.0.0-rc.112",
    "@effect/ai-openrouter": "4.0.0-rc.112",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/sql-pg": "4.0.0-rc.112",
    "@rika/box-executor": "workspace:*",
    "@rika/client": "workspace:*",
    "@rika/context": "workspace:*",
    "@rika/credential-vault": "workspace:*",
    "@rika/execution": "workspace:*",
    "@rika/github-app": "workspace:*",
    "@rika/identity": "workspace:*",
    "@rika/product": "workspace:*",
    "@rika/product-store": "workspace:*",
    "@rika/workspace-input": "workspace:*",
    "@standard-schema/spec": "1.1.0",
    "drizzle-orm": "catalog:",
    "effect": "4.0.0-rc.112",
    "generalist": "catalog:",
    "pg": "catalog:",
    "rivetkit": "2.3.15"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@rika/runner": "workspace:*",
    "@effect/vitest": "4.0.0-rc.112",
    "@types/bun": "1.4.0",
    "@types/pg": "catalog:",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "rika": {
    "kind": "application",
    "domain": "api"
  }
}
