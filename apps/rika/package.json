{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@rika/cli",
  "version": "0.12.14",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "rika": "./dist/client-main.js"
  },
  "scripts": {
    "build": "bun ./src/build.ts",
    "lint": "bun --cwd ../.. node_modules/oxlint/dist/cli.js --deny-warnings apps/rika/src apps/rika/test",
    "start": "bun ./src/client-main.ts",
    "typecheck": "bun ../../node_modules/typescript/lib/tsc.js --noEmit"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@opentui/core": "catalog:",
    "@opentui/solid": "catalog:",
    "@rika/client": "workspace:*",
    "@rika/configuration": "workspace:*",
    "@rika/extensions": "workspace:*",
    "@rika/product": "workspace:*",
    "@rika/runner": "workspace:*",
    "@rika/terminal": "workspace:*",
    "@rika/tui-v2": "workspace:*",
    "@rika/workspace-input": "workspace:*",
    "effect": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@rika/identity": "workspace:*",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "optionalDependencies": {
    "@opentui/core-darwin-arm64": "catalog:",
    "@opentui/core-darwin-x64": "catalog:",
    "@opentui/core-linux-arm64": "catalog:",
    "@opentui/core-linux-arm64-musl": "catalog:",
    "@opentui/core-linux-x64": "catalog:",
    "@opentui/core-linux-x64-musl": "catalog:",
    "@opentui/core-win32-arm64": "catalog:",
    "@opentui/core-win32-x64": "catalog:"
  },
  "rika": {
    "kind": "application",
    "domain": "cli"
  }
}
