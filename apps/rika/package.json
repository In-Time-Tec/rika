{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@rika/cli",
  "version": "0.3.12",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "rika": "./dist/client-main.js"
  },
  "scripts": {
    "build": "bun build ./src/client-main.ts ./src/interactive-main.ts ./src/server-main.ts ./src/performance-main.ts --outdir dist --target bun --format esm --splitting --loader .txt:text --external @opentui/core-darwin-arm64 --external @opentui/core-darwin-x64 --external @opentui/core-linux-arm64 --external @opentui/core-linux-arm64-musl --external @opentui/core-linux-x64 --external @opentui/core-linux-x64-musl --external @opentui/core-win32-arm64 --external @opentui/core-win32-x64",
    "lint": "bun --cwd ../.. node_modules/oxlint/dist/cli.js apps/rika/src apps/rika/test",
    "start": "bun ./src/client-main.ts",
    "typecheck": "bun ../../node_modules/typescript/lib/tsc.js --noEmit"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@opentui/core": "catalog:",
    "@rika/baton-execution": "workspace:*",
    "@rika/product": "workspace:*",
    "@rika/configuration": "workspace:*",
    "@rika/extensions": "workspace:*",
    "@rika/javascript-sandbox": "workspace:*",
    "@rika/product-store": "workspace:*",
    "@rika/coding-tools": "workspace:*",
    "@rika/terminal": "workspace:*",
    "@rika/transcript": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "optionalDependencies": {
    "@opentui/core-darwin-arm64": "catalog:",
    "@opentui/core-darwin-x64": "catalog:",
    "@opentui/core-linux-arm64": "catalog:",
    "@opentui/core-linux-arm64-musl": "catalog:",
    "@opentui/core-linux-x64": "catalog:",
    "@opentui/core-linux-x64-musl": "catalog:",
    "@opentui/core-win32-arm64": "catalog:",
    "@opentui/core-win32-x64": "catalog:"
  },
  "rika": {
    "kind": "application",
    "domain": "cli"
  }
}
